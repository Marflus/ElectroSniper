# --- ANTHROPIC ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_TRIAGE_MODEL=claude-haiku-5-5
ANTHROPIC_DEEP_MODEL=claude-sonnet-5-5

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SCAN & SEUILS ---
SCAN_INTERVAL_MINUTES=10
MIN_ALERT_SCORE=72
MIN_ALERT_PROFIT_EUR=30
MIN_PRICE_EUR=10
MAX_PRICE_EUR=500
MAX_AI_PER_CYCLE=20
REQUIRE_SHIPPING=true
EXCLUDE_ALREADY_OPENED=false

# --- SITES ACTIFS ---
ENABLE_LEBONCOIN=true
ENABLE_VINTED=true
ENABLE_FACEBOOK=false
ENABLE_EBAY=false

# --- EBAY API (optionnel, à remplir quand tu auras l'accès) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- INTERFACE WEB ---
WEB_HOST=127.0.0.1
WEB_PORT=8765
